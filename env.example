# ── Copy this file to .env and fill in your values ──────────────────────────

# SMTP server (Gmail shown as example)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"

# Your sending email account
SMTP_USER="you@gmail.com"

# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled)
SMTP_PASS="your-app-password-here"

# "From" display name and address
FROM_NAME="Santa Cruz Local Legends"
FROM_EMAIL="you@gmail.com"

# Default reply-to email shown in the newsletter
REPLY_EMAIL="hello@example.com"

# Flask secret key (any random string is fine)
SECRET_KEY="change-me-to-something-random"
